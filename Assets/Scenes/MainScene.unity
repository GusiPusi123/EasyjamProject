    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "(\u043E\u0434\u043D\u0430 \u0438\u0437 \u0441\u0442\u0440\u0430\u043D\u0438\u0446
    \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0430 \u0431\u0430\u0431\u0443\u0448\u043A\u0438)\n\n\u2003\u041F\u0435\u0440\u0432\u044B\u0439
    \u0434\u0435\u043D\u044C \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438
    \u0434\u0435\u0434\u0430. \u041A\u043E \u043C\u043D\u0435 \u0432 \u0433\u043E\u0441\u0442\u0438
    \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C \u043F\u0440\u0438\u0435\u0445\u0430\u043B
    \u043C\u043E\u0439 \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u0432\u043D\u0443\u0447\u0435\u043A.
    \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0435\u0433\u043E \u0443 \u0441\u0435\u0431\u044F \u0438 \u043D\u0438\u043A\u0443\u0434\u0430
    \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0442\u044C,  \u0447\u0442\u043E\u0431\u044B
    \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u0442\u0430\u043A
    \u0436\u0435, \u043A\u0430\u043A \u0441 \u043C\u043E\u0438\u043C \u043B\u044E\u0431\u0438\u043C\u044B\u043C
    \u043C\u0443\u0436\u0435\u043C. \u042F \u0432\u0435\u0434\u044C \u0442\u0430\u043A
    \u043B\u044E\u0431\u0438\u043B\u0430  \u0435\u0433\u043E...\n\u0412\u0442\u043E\u0440\u043E\u0439
    \u0434\u0435\u043D\u044C. \u041D\u0443\u0436\u043D\u043E \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
    \u043A\u0430\u043A-\u0442\u043E \u043A\u043E \u043C\u043D\u0435 \u043C\u043E\u044E
    \u0434\u043E\u0447\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
    \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0445 \u0434\u0432\u043E\u0438\u0445.
    \u0410 \u0435\u0449\u0451 \u043C\u0435\u043D\u044F \u0443\u0436\u0435 \u0434\u043E\u0441\u0442\u0430\u043B\u0430
    \u044D\u0442\u0430  \u0434\u0443\u0440\u043D\u0430\u044F \u0436\u0435\u043D\u0430
    \u043C\u043E\u0435\u0433\u043E \u0432\u043D\u0443\u0447\u043A\u0430 \u2014 \u043A\u0430\u043A
    \u0431\u044B \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u043E\u0442
    \u043D\u0435\u0451, \u0434\u0430 \u0440\u0430\u0437 \u0438  \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430..."
