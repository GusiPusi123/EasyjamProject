    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u0430 \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
    \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435, \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u043E\u0435
    \u0441 \u0432\u0430\u043C\u0438. \u0422\u0435\u043F\u0435\u0440\u044C, \u043A\u043E\u0433\u0434\u0430
    \u043C\u043E\u0439 \u043C\u0443\u0436 \u0443\u0448\u0435\u043B, \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E,
    \u0447\u0442\u043E \u043F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F
    \u043F\u0440\u043E\u0449\u0430\u0442\u044C\u0441\u044F. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
    \u043D\u0435 \u0433\u0440\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u043E\u043B\u0433\u043E
    \u2014 \u043F\u043E\u043C\u043D\u0438\u0442\u0435, \u0447\u0442\u043E \u044F
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0443 \u0441 \u0432\u0430\u043C\u0438
    \u0432 \u0432\u0430\u0448\u0438\u0445 \u0441\u0435\u0440\u0434\u0446\u0430\u0445.
    \u041F\u0443\u0441\u0442\u044C \u0432\u0430\u0448\u0430 \u0436\u0438\u0437\u043D\u044C
    \u0431\u0443\u0434\u0435\u0442 \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430
    \u043B\u044E\u0431\u043E\u0432\u044C\u044E \u0438 \u0442\u0435\u043F\u043B\u043E\u043C.
    \u0421\u043E \u0432\u0441\u0435\u0439 \u043B\u044E\u0431\u043E\u0432\u044C\u044E
    \u0438 \u043D\u0435\u0436\u043D\u043E\u0441\u0442\u044C\u044E, \u0412\u0430\u0448\u0430
    \u0431\u0430\u0431\u0443\u0448\u043A\u0430"
